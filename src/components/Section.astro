---
const { className, title } = Astro.props;
---

<section class:list={["flex flex-col gap-4 print:gap-0", className]}>
	{title && (
		<h3 class="relative flex w-full items-center gap-3 pb-4 text-3xl print:gap-1 print:pb-0 print:text-xl">
			<span class="accent-bar" aria-hidden="true"></span>
			{title}
		</h3>
	)}
	<slot />
</section>

<style>
	.accent-bar {
		display: inline-block;
		width: 3px;
		height: 1.4em;
		border-radius: 3px;
		background: linear-gradient(180deg, rgb(var(--color)), rgba(var(--color), 0.2));
		flex-shrink: 0;
	}

	@media print {
		.accent-bar {
			display: none;
		}
	}
</style>
