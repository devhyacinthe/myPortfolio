---
import { ui } from "@/i18n/ui";
import T from "@/components/T.astro";
import Git from "@/icons/git.astro";

interface Project {
  name: string;
  description: string;
  description_en?: string;
  highlights?: string[];
  url?: string;
  github?: string;
  isActive?: boolean;
}

interface Props {
  project: Project;
  delay?: number;
}

const { project } = Astro.props;
const { name, description, description_en, highlights = [], url, github } = project;
const hasLive = Boolean(url);
---

<article class="card reveal glass">
  <div class="card-top">
    <span class="folder" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
    </span>
    <div class="card-links">
      {
        github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="mini" title={ui.work.codeLabel.fr} aria-label="GitHub">
            <Git />
          </a>
        )
      }
      {
        hasLive && (
          <a href={url} target="_blank" rel="noopener noreferrer" class="mini" title={ui.work.liveLabel.fr} aria-label="Live">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
          </a>
        )
      }
    </div>
  </div>

  <h3 class="card-title">
    {
      hasLive ? (
        <a href={url} target="_blank" rel="noopener noreferrer">
          {name}
        </a>
      ) : (
        <span>{name}</span>
      )
    }
  </h3>

  <p class="card-desc">
    <T fr={description} en={description_en ?? description} />
  </p>

  {
    highlights.length > 0 && (
      <ul class="tags">
        {highlights.map((h) => (
          <li class="tag mono">{h}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem;
    border-radius: 1rem;
    height: 100%;
    position: relative;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(120deg, rgba(var(--color), 0.5), rgba(var(--color-2), 0.5));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -24px rgba(var(--color), 0.6);
  }
  .card:hover::before {
    opacity: 1;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .folder {
    color: rgb(var(--color));
    display: inline-flex;
  }
  .card-links {
    display: flex;
    gap: 0.35rem;
  }
  .mini {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    color: rgb(var(--color-text-muted));
    transition: color 0.2s ease, background 0.2s ease;
  }
  .mini:hover {
    color: rgb(var(--color));
    background: rgba(var(--color), 0.1);
  }
  .mini :global(svg) {
    width: 18px;
    height: 18px;
  }

  .card-title {
    font-size: 1.15rem;
  }
  .card-title a:hover {
    color: rgb(var(--color));
  }
  .card-desc {
    font-size: 0.9rem;
    flex-grow: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }
  .tag {
    font-size: 0.68rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.4rem;
    color: rgb(var(--color));
    background: rgba(var(--color), 0.1);
    border: 1px solid rgba(var(--color), 0.2);
  }
</style>
