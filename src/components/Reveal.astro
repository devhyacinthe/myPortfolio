---
// Scroll-reveal wrapper. Adds .reveal; a global observer flips it to
// .is-visible when it enters the viewport. Respects prefers-reduced-motion.
interface Props {
  as?: keyof HTMLElementTagNameMap;
  delay?: number; // ms, for staggering
  class?: string;
}
const { as = "div", delay = 0, class: className } = Astro.props;
const Wrapper = as;
---

<Wrapper class:list={["reveal", className]} style={`--reveal-delay:${delay}ms`}>
  <slot />
</Wrapper>

<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<!-- The reveal observer lives as an inline, self-contained script in BaseLayout
     so it can never be broken by another bundled module failing to load. -->
