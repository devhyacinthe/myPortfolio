---
import { basics } from "@cv";
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import type { SocialIcon } from "@/types";

const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
	GitHub,
	LinkedIn,
	X,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ");
---

<Section>
	<div class="hero-wrapper">
		<figure class="photo-container print:hidden">
			<div class="ring-outer">
				<div class="ring-inner">
					<img src={image} alt={name} />
				</div>
			</div>
			<div class="status-badge">
				<span class="dot"></span>
				<span class="badge-label">Disponible</span>
			</div>
		</figure>

		<div class="hero-info">
			<h1>{name}</h1>
			<h2>{label}</h2>
			<div class="location-tag">
				<WorldMap />
				<span>{city}, {region}</span>
			</div>

			<footer class="print">
				{printInfo}
			</footer>

			<footer class="no-print social-links">
				{
					email && (
						<div x-data=`{ copyText: '${email}', copyNotification: false, copyToClipboard() { navigator.clipboard.writeText(this.copyText); this.copyNotification = true; let that = this; setTimeout(function(){ that.copyNotification = false; }, 3000); } }` class="relative">
							<div x-show="copyNotification" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-3" x-transition:enter-end="opacity-100 translate-x-0" x-transition:leave="transition ease-in duration-300" x-transition:leave-start="opacity-100 translate-x-0" x-transition:leave-end="opacity-0 translate-y-2" style="display:none;" class="absolute left-0 bottom-full mb-2" x-cloak>
								<div class="flex h-7 items-center rounded bg-green-500 px-3 text-xs">
									<span class="text-white">Copié!</span>
								</div>
							</div>
							<button @click="copyToClipboard();" class="icon-btn" title={`Copier ${email}`}>
								<svg x-show="copyNotification" class="h-4 w-4 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" x-cloak>
									<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
								</svg>
								<span x-show="!copyNotification">
									<Mail />
								</span>
							</button>
						</div>
					)
				}
				{
					phone && (
						<a href={`tel:${phone}`} title={`Appeler ${name}`} target="_blank" rel="noopener noreferrer" class="icon-btn">
							<Phone />
						</a>
					)
				}
				{
					profiles.map(({ network, url }) => {
						const Icon = SOCIAL_ICONS[network];
						return (
							<a href={url} title={`Profil ${network}`} target="_blank" rel="noopener noreferrer" class="icon-btn">
								<Icon />
							</a>
						);
					})
				}
				<div class="no-print footer-button max-sm:hidden icon-btn" style="cursor:pointer;">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
						<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
						<path d="M7 9a2 2 0 1 1 2 -2v10a2 2 0 1 1 -2 -2h10a2 2 0 1 1 -2 2v-10a2 2 0 1 1 2 2h-10"></path>
					</svg>
				</div>
			</footer>
		</div>
	</div>
</Section>

<style>
	.hero-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		text-align: center;
	}

	/* ── Photo ── */
	.photo-container {
		position: relative;
		padding-bottom: 1.25rem;
		width: fit-content;
		margin: 0 auto;
	}

	.ring-outer {
		width: 10rem;
		height: 10rem;
		border-radius: 9999px;
		padding: 3px;
		background: conic-gradient(
			from 0deg,
			rgb(var(--color)) 0%,
			transparent 30%,
			rgba(var(--color), 0.2) 50%,
			transparent 70%,
			rgb(var(--color)) 100%
		);
		animation: spin-ring 5s linear infinite;
		box-sizing: border-box;
	}

	.ring-inner {
		width: 100%;
		height: 100%;
		border-radius: 9999px;
		overflow: hidden;
		animation: counter-spin 5s linear infinite;
		background: rgb(var(--color-fill));
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 9999px;
	}

	@keyframes spin-ring {
		to { transform: rotate(360deg); }
	}
	@keyframes counter-spin {
		to { transform: rotate(-360deg); }
	}

	/* ── Status badge ── */
	.status-badge {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: 0.35rem;
		background: rgb(var(--color-fill));
		border: 1px solid rgba(var(--color), 0.25);
		border-radius: 9999px;
		padding: 0.22rem 0.85rem;
		white-space: nowrap;
		box-shadow: 0 4px 16px rgba(var(--color), 0.15);
	}

	.dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 9999px;
		background: #22c55e;
		flex-shrink: 0;
		animation: pulse-dot 2s ease-in-out infinite;
	}

	.badge-label {
		font-size: 0.7rem;
		font-weight: 600;
		color: rgb(var(--color));
		letter-spacing: 0.03em;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.6; transform: scale(0.85); }
	}

	/* ── Info ── */
	.hero-info {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
	}

	h1 {
		font-size: 1.85rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		line-height: 1.1;
		background: linear-gradient(135deg, rgb(var(--color-text-base)) 30%, rgb(var(--color)));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	h2 {
		font-size: 0.8rem;
		color: rgb(var(--color-text-muted));
		text-wrap: balance;
		line-height: 1.45;
		max-width: 22ch;
	}

	.location-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.4rem;
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		background: rgba(var(--color), 0.08);
		border: 1px solid rgba(var(--color), 0.18);
		font-size: 0.72rem;
		color: rgb(var(--color-text-muted));
	}

	/* ── Social links ── */
	footer.print {
		display: none;
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		margin-top: 0.85rem;
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.6rem;
		border: 1px solid rgba(var(--color), 0.2);
		background: rgba(var(--color), 0.05);
		color: rgb(var(--color));
		transition: all 0.2s ease;
		cursor: pointer;
	}

	.icon-btn:hover {
		background: rgb(var(--color-button-accent));
		border-color: rgb(var(--color-button-accent));
		color: rgb(var(--color-text-inverted));
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(var(--color), 0.35);
	}

	@media print {
		footer.print {
			display: block;
		}
		.no-print {
			display: none;
		}
		h1 {
			-webkit-text-fill-color: unset;
			color: black;
		}
	}
</style>

<script>
	const select = document.getElementById("themeSwitch") as HTMLSelectElement;
	const theme = localStorage.getItem("theme");
	const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

	if (theme !== null) {
		select.value = theme;
	} else {
		select.value = systemTheme;
	}

	function updateTheme(value: string) {
		const theme = value === "system" ? systemTheme : value;
		document.documentElement.classList.remove("light", "dark");
		document.documentElement.classList.add(theme);
		localStorage.setItem("theme", value);
	}

	updateTheme(select.value);

	select.addEventListener("change", (event: Event) => {
		const select = event.target as HTMLSelectElement;
		updateTheme(select.value);
	});

	window.addEventListener("beforeprint", () => {
		document.documentElement.classList.remove("dark");
	});

	window.addEventListener("afterprint", () => {
		if (select.value === "dark" || (select.value === "system" && systemTheme === "dark")) {
			document.documentElement.classList.add("dark");
		}
	});
</script>
