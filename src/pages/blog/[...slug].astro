---
import BaseLayout from "@/layouts/BaseLayout.astro";
import T from "@/components/T.astro";
import { ui } from "@/i18n/ui";
import { getCollection } from "astro:content";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content: FrContent } = await post.render();

// Matching English body (same slug in the blog-en collection); fall back to FR.
const enEntries = await getCollection("blog-en");
const enPost = enEntries.find((e) => e.slug === post.slug);
let EnContent = FrContent;
if (enPost) {
  EnContent = (await enPost.render()).Content;
}

const base = import.meta.env.BASE_URL;

const readingTime = Math.max(1, Math.round(post.body.split(/\s+/).length / 200));
const fmt = (d: Date, locale: string) =>
  d.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={`${post.data.title} — ${"d'ALMEIDA Hyacinthe"}`} description={post.data.description}>
  <article class="article">
    <a href={`${base}blog/`} class="back mono">
      <span aria-hidden="true">←</span> <T t={ui.blog.back} />
    </a>

    <header class="article-head">
      <ul class="head-tags">
        {post.data.tags.map((t) => <li class="tag mono">{t}</li>)}
      </ul>
      <h1><T fr={post.data.title} en={post.data.title_en ?? post.data.title} /></h1>
      <p class="lead">
        <T fr={post.data.description} en={post.data.description_en ?? post.data.description} />
      </p>
      <div class="meta mono">
        <span>{post.data.author}</span>
        <span class="sep">·</span>
        <time datetime={post.data.date.toISOString()}>
          <span data-l="fr">{fmt(post.data.date, "fr-FR")}</span>
          <span data-l="en">{fmt(post.data.date, "en-US")}</span>
        </time>
        <span class="sep">·</span>
        <span>{readingTime} <T t={ui.blog.minRead} /></span>
      </div>
    </header>

    <div class="prose" data-l="fr">
      <FrContent />
    </div>
    <div class="prose" data-l="en">
      <EnContent />
    </div>

    <footer class="article-foot">
      <a href={`${base}blog/`} class="back mono">
        <span aria-hidden="true">←</span> <T t={ui.blog.back} />
      </a>
      <a href={`${base}contact/`} class="btn btn-primary"><T t={ui.hero.ctaContact} /></a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2rem 0 1rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgb(var(--color-text-muted));
    transition: color 0.2s ease;
  }
  .back:hover {
    color: rgb(var(--color));
  }

  .article-head {
    margin: 1.5rem 0 2.5rem;
  }
  .head-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .tag {
    font-size: 0.68rem;
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
    color: rgb(var(--color));
    background: rgba(var(--color), 0.1);
    border: 1px solid rgba(var(--color), 0.2);
  }
  .article-head h1 {
    font-size: clamp(2rem, 5vw, 2.9rem);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .lead {
    font-size: 1.1rem;
    color: rgb(var(--color-text-muted));
    margin: 0 0 1.1rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: rgb(var(--color-text-muted));
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(var(--color-text-base), 0.1);
  }
  .sep {
    opacity: 0.5;
  }

  .article-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(var(--color-text-base), 0.1);
  }
</style>

<style is:global>
  /* ── Prose (rendered markdown) ── */
  .prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: rgb(var(--color-text-base));
  }
  .prose > * + * {
    margin-top: 1.25rem;
  }
  .prose h2 {
    font-size: 1.6rem;
    line-height: 1.25;
    margin-top: 2.75rem;
    margin-bottom: 0.25rem;
    scroll-margin-top: 6rem;
  }
  .prose h3 {
    font-size: 1.22rem;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
  }
  .prose p,
  .prose li {
    color: rgb(var(--color-text-muted));
  }
  .prose strong {
    color: rgb(var(--color-text-base));
    font-weight: 600;
  }
  .prose a {
    color: rgb(var(--color));
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(var(--color), 0.4);
  }
  .prose a:hover {
    text-decoration-color: rgb(var(--color));
  }
  .prose ul,
  .prose ol {
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .prose ul {
    list-style: disc;
  }
  .prose ol {
    list-style: decimal;
  }
  .prose li::marker {
    color: rgb(var(--color));
  }
  .prose li > ul,
  .prose li > ol {
    margin-top: 0.5rem;
  }

  /* Inline code */
  .prose :not(pre) > code {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: 0.35rem;
    color: rgb(var(--color));
    background: rgba(var(--color), 0.1);
    border: 1px solid rgba(var(--color), 0.18);
    word-break: break-word;
  }

  /* Code blocks (Shiki) */
  .prose pre {
    padding: 1.15rem 1.25rem;
    border-radius: 0.8rem;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.6;
    border: 1px solid rgba(255, 255, 255, 0.08);
    tab-size: 2;
  }
  .prose pre code {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    background: none;
    padding: 0;
    border: 0;
  }

  /* Blockquote → callout */
  .prose blockquote {
    margin: 1.75rem 0;
    padding: 1rem 1.25rem;
    border-radius: 0.6rem;
    border-left: 3px solid rgb(var(--color));
    background: rgba(var(--color), 0.07);
  }
  .prose blockquote p {
    margin: 0;
    color: rgb(var(--color-text-base));
  }

  /* Tables */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    padding: 0.6rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid rgba(var(--color-text-base), 0.12);
  }
  .prose th {
    color: rgb(var(--color-text-base));
    font-weight: 600;
    white-space: nowrap;
  }
  .prose td {
    color: rgb(var(--color-text-muted));
  }

  /* Figures / illustrations */
  .prose .post-figure {
    margin: 2rem 0;
    padding: 1.5rem;
    border-radius: 0.9rem;
    background: rgba(var(--color-text-base), 0.025);
    border: 1px solid rgba(var(--color-text-base), 0.1);
    text-align: center;
  }
  :global(.dark) .prose .post-figure {
    background: rgba(255, 255, 255, 0.028);
  }
  .prose .post-figure svg {
    width: 100%;
    max-width: 420px;
    height: auto;
    color: rgb(var(--color-text-muted));
  }
  .prose figcaption {
    margin-top: 0.85rem;
    font-size: 0.82rem;
    color: rgb(var(--color-text-muted));
  }

  .prose hr {
    border: 0;
    border-top: 1px solid rgba(var(--color-text-base), 0.12);
    margin: 2.5rem 0;
  }

  /* KaTeX: keep display equations scrollable on small screens */
  .prose .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
  }
</style>
