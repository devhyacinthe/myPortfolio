---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TechStack from "@/components/TechStack.astro";
import Reveal from "@/components/Reveal.astro";
import T from "@/components/T.astro";
import { ui } from "@/i18n/ui";
import { basics, projects } from "@cv";

const { name, label, image, tagline, tagline_en, email } = basics as any;
const base = import.meta.env.BASE_URL;
// Home spotlight: exactly these three, in this order.
const FEATURED_ORDER = ["Hospital DataWarehouse", "Real estate regression model", "AquaTogoManager"];
const featured = FEATURED_ORDER.map((n) => projects.find((p: any) => p.name === n)).filter(Boolean);

const services = [
  {
    icon: `<path d="M12 18h.01M8 21h8a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1Z"/>`,
    title: ui.services.mobile,
    desc: ui.services.mobileDesc,
  },
  {
    icon: `<path d="m18 16 4-4-4-4M6 8l-4 4 4 4M14.5 4l-5 16"/>`,
    title: ui.services.backend,
    desc: ui.services.backendDesc,
  },
  {
    icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5M3 12a9 3 0 0 0 18 0"/>`,
    title: ui.services.data,
    desc: ui.services.dataDesc,
  },
];
---

<BaseLayout>
  {/* ── Hero ── */}
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow" data-hero><span class="wave">👋</span> <T t={ui.hero.greeting} /></p>
      <h1 class="hero-name" data-hero>
        <span class="shine">{name}</span>
      </h1>
      <p class="hero-role" data-hero>
        <span class="text-gradient mono">&lt;</span>
        {label}
        <span class="text-gradient mono">/&gt;</span>
      </p>
      <p class="hero-tagline" data-hero>
        <T fr={tagline} en={tagline_en ?? tagline} />
      </p>

      <div class="hero-status" data-hero>
        <span class="pulse"></span>
        <T t={ui.hero.available} />
      </div>

      <div class="hero-cta" data-hero>
        <a href={`${base}work/`} class="btn btn-primary">
          <T t={ui.hero.ctaWork} />
        </a>
        <a href={`${base}contact/`} class="btn btn-ghost">
          <T t={ui.hero.ctaContact} />
        </a>
      </div>
    </div>

    <div class="hero-photo" data-hero-photo>
      <div class="ring-outer">
        <div class="ring-inner">
          <img src={image} alt={name} width="288" height="288" />
        </div>
      </div>
      <a href={`mailto:${email}`} class="photo-badge mono">{email}</a>
    </div>

    <a href="#stack" class="scroll-cue" aria-label="Scroll">
      <span class="mono"><T t={ui.hero.scroll} /></span>
      <span class="scroll-mouse"><span class="scroll-wheel"></span></span>
    </a>
  </section>

  {/* ── Tech stack ── */}
  <section class="block" id="stack">
    <SectionHeading
      num="01."
      titleFr={ui.home.stackTitle.fr}
      titleEn={ui.home.stackTitle.en}
      subFr="Mes outils par domaine d'expertise."
      subEn="My tools grouped by area of expertise."
    />
    <TechStack />
  </section>

  {/* ── What I do ── */}
  <section class="block">
    <SectionHeading
      num="02."
      titleFr={ui.home.doTitle.fr}
      titleEn={ui.home.doTitle.en}
      subFr={ui.home.doSubtitle.fr}
      subEn={ui.home.doSubtitle.en}
    />
    <div class="services">
      {
        services.map((s, i) => (
          <Reveal delay={i * 90}>
            <article class="service glass">
              <span class="service-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
              </span>
              <h3><T t={s.title} /></h3>
              <p><T t={s.desc} /></p>
            </article>
          </Reveal>
        ))
      }
    </div>
  </section>

  {/* ── Featured work ── */}
  <section class="block">
    <SectionHeading
      num="03."
      titleFr={ui.home.featuredTitle.fr}
      titleEn={ui.home.featuredTitle.en}
      subFr={ui.home.featuredSubtitle.fr}
      subEn={ui.home.featuredSubtitle.en}
    />
    <div class="projects">
      {featured.map((p: any) => <ProjectCard project={p} />)}
    </div>
    <div class="see-all">
      <a href={`${base}work/`} class="btn btn-ghost">
        <T t={ui.home.seeAll} />
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    min-height: calc(100vh - 6rem);
    padding: clamp(2rem, 6vw, 4rem) 0 5rem;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* ── Entrance sequence on load ── */
  [data-hero] {
    opacity: 0;
    animation: heroIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  [data-hero]:nth-child(1) { animation-delay: 0.05s; }
  [data-hero]:nth-child(2) { animation-delay: 0.15s; }
  [data-hero]:nth-child(3) { animation-delay: 0.25s; }
  [data-hero]:nth-child(4) { animation-delay: 0.35s; }
  [data-hero]:nth-child(5) { animation-delay: 0.45s; }
  [data-hero]:nth-child(6) { animation-delay: 0.55s; }
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(22px); filter: blur(6px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  [data-hero-photo] {
    opacity: 0;
    animation: photoIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
  }
  @keyframes photoIn {
    from { opacity: 0; transform: scale(0.85) rotate(-4deg); }
    to { opacity: 1; transform: scale(1) rotate(0); }
  }

  .wave {
    display: inline-block;
    animation: wave 2.5s ease-in-out infinite;
    transform-origin: 70% 70%;
  }
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
  }

  .hero-name {
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1.05;
  }
  .hero-name .shine {
    background: linear-gradient(
      100deg,
      rgb(var(--color-text-base)) 0%,
      rgb(var(--color-text-base)) 35%,
      rgb(var(--color)) 55%,
      rgb(var(--color-2)) 70%,
      rgb(var(--color-text-base)) 90%
    );
    background-size: 220% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: shine 6s ease-in-out 0.8s infinite;
  }
  @keyframes shine {
    0%, 100% { background-position: 100% 0; }
    50% { background-position: 0 0; }
  }
  .hero-role {
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: rgb(var(--color-text-base));
    margin: 0.25rem 0;
  }
  .hero-tagline {
    max-width: 40ch;
    font-size: 1.02rem;
    margin: 0.25rem 0 0.5rem;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin: 0.4rem 0 0.6rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #16a34a;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }
  :global(.dark) .hero-status {
    color: #4ade80;
  }
  .pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
    50% { opacity: 0.7; transform: scale(0.9); box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.75rem;
  }

  /* Photo */
  .hero-photo {
    justify-self: center;
    position: relative;
    width: fit-content;
  }
  .ring-outer {
    width: clamp(14rem, 30vw, 18rem);
    height: clamp(14rem, 30vw, 18rem);
    border-radius: 9999px;
    padding: 4px;
    background: conic-gradient(
      from 0deg,
      rgb(var(--color)) 0%,
      transparent 30%,
      rgba(var(--color-2), 0.6) 50%,
      transparent 70%,
      rgb(var(--color)) 100%
    );
    animation: spin 6s linear infinite;
  }
  .ring-inner {
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    overflow: hidden;
    background: rgb(var(--color-fill));
    animation: spin-rev 6s linear infinite;
  }
  .ring-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes spin-rev { to { transform: rotate(-360deg); } }

  .photo-badge {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    color: rgb(var(--color-text-base));
    background: rgb(var(--color-fill));
    border: 1px solid rgba(var(--color), 0.3);
    box-shadow: 0 8px 20px -8px rgba(var(--color), 0.4);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .photo-badge:hover {
    color: rgb(var(--color));
    border-color: rgb(var(--color));
  }

  /* Blocks */
  .block {
    padding: 3rem 0;
  }
  .center-eyebrow {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .services {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .services {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .service {
    height: 100%;
    padding: 1.75rem 1.5rem;
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .service:hover {
    transform: translateY(-4px);
  }
  .service-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.8rem;
    color: rgb(var(--color));
    background: rgba(var(--color), 0.12);
    margin-bottom: 0.35rem;
  }
  .service h3 {
    font-size: 1.15rem;
  }
  .service p {
    font-size: 0.92rem;
  }

  .projects {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .projects {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .see-all {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* Scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(var(--color-text-muted));
    opacity: 0;
    animation: heroIn 0.7s ease 1s forwards;
  }
  .scroll-cue:hover {
    color: rgb(var(--color));
  }
  .scroll-mouse {
    width: 1.15rem;
    height: 1.9rem;
    border-radius: 9999px;
    border: 2px solid currentColor;
    display: flex;
    justify-content: center;
    padding-top: 0.3rem;
  }
  .scroll-wheel {
    width: 0.2rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: currentColor;
    animation: wheel 1.6s ease-in-out infinite;
  }
  @keyframes wheel {
    0% { opacity: 0; transform: translateY(-3px); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: translateY(6px); }
  }
  @media (max-width: 640px) {
    .scroll-cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave, .pulse, .ring-outer, .ring-inner, .hero-name .shine, .scroll-wheel {
      animation: none;
    }
    [data-hero], [data-hero-photo], .scroll-cue {
      opacity: 1;
      animation: none;
      transform: none;
      filter: none;
    }
  }
</style>
