---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import T from "@/components/T.astro";
import { ui } from "@/i18n/ui";
import { basics } from "@cv";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const readingTime = (body: string) => Math.max(1, Math.round(body.split(/\s+/).length / 200));
const fmt = (d: Date, locale: string) =>
  d.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title={`${basics.name} — Blog`}>
  <section class="block">
    <SectionHeading
      num="•"
      titleFr={ui.blog.title.fr}
      titleEn={ui.blog.title.en}
      subFr={ui.blog.subtitle.fr}
      subEn={ui.blog.subtitle.en}
    />

    {
      posts.length === 0 ? (
        <p class="empty"><T t={ui.blog.empty} /></p>
      ) : (
        <ul class="post-list">
          {posts.map((post, i) => (
            <Reveal as="li" delay={i * 70}>
              <a href={`${base}blog/${post.slug}/`} class="post-card">
                <div class="post-meta mono">
                  <time datetime={post.data.date.toISOString()}>
                    <span data-l="fr">{fmt(post.data.date, "fr-FR")}</span>
                    <span data-l="en">{fmt(post.data.date, "en-US")}</span>
                  </time>
                  <span class="dot-sep">·</span>
                  <span>{readingTime(post.body)} <T t={ui.blog.minRead} /></span>
                </div>
                <h2 class="post-title">
                  <T fr={post.data.title} en={post.data.title_en ?? post.data.title} />
                </h2>
                <p class="post-desc">
                  <T fr={post.data.description} en={post.data.description_en ?? post.data.description} />
                </p>
                <div class="post-foot">
                  <ul class="post-tags">
                    {post.data.tags.slice(0, 4).map((t) => (
                      <li class="tag mono">{t}</li>
                    ))}
                  </ul>
                  <span class="post-arrow">
                    <T t={ui.blog.readArticle} /> <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </Reveal>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .block {
    padding: 2.5rem 0;
  }
  .empty {
    padding: 3rem 0;
    font-size: 1.05rem;
    text-align: center;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem 1.75rem;
    border-radius: 1.1rem;
    background: rgba(var(--color-text-base), 0.025);
    border: 1px solid rgba(var(--color-text-base), 0.1);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  :global(.dark) .post-card {
    background: rgba(255, 255, 255, 0.028);
    border-color: rgba(255, 255, 255, 0.09);
  }
  .post-card:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--color), 0.45);
    box-shadow: 0 22px 44px -28px rgba(var(--color), 0.5);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    color: rgb(var(--color-text-muted));
  }
  .dot-sep {
    opacity: 0.6;
  }
  .post-title {
    font-size: 1.4rem;
    line-height: 1.2;
  }
  .post-card:hover .post-title {
    color: rgb(var(--color));
  }
  .post-desc {
    font-size: 0.95rem;
    margin: 0;
  }

  .post-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: 0.68rem;
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
    color: rgb(var(--color));
    background: rgba(var(--color), 0.1);
    border: 1px solid rgba(var(--color), 0.2);
  }
  .post-arrow {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgb(var(--color));
    white-space: nowrap;
  }
</style>
