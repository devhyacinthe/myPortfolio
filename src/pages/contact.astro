---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Reveal from "@/components/Reveal.astro";
import T from "@/components/T.astro";
import { ui } from "@/i18n/ui";
import { basics } from "@cv";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";

const { email, phone, profiles } = basics;
const linkedin = profiles.find((p: any) => p.network === "LinkedIn")?.url ?? "";
const github = profiles.find((p: any) => p.network === "GitHub")?.url ?? "";
---

<BaseLayout title={`${basics.name} — Contact`}>
  <section class="block">
    <SectionHeading
      num="•"
      titleFr={ui.contact.title.fr}
      titleEn={ui.contact.title.en}
      subFr={ui.contact.subtitle.fr}
      subEn={ui.contact.subtitle.en}
    />

    <div class="contact-grid">
      {/* Form */}
      <Reveal>
        <form id="contactForm" class="form glass" data-email={email} novalidate>
          <label class="field">
            <span><T t={ui.contact.name} /></span>
            <input type="text" name="name" required data-ph-fr={ui.contact.namePlaceholder.fr} data-ph-en={ui.contact.namePlaceholder.en} />
          </label>
          <label class="field">
            <span><T t={ui.contact.subject} /></span>
            <input type="text" name="subject" required data-ph-fr={ui.contact.subjectPlaceholder.fr} data-ph-en={ui.contact.subjectPlaceholder.en} />
          </label>
          <label class="field">
            <span><T t={ui.contact.message} /></span>
            <textarea name="message" rows="5" required data-ph-fr={ui.contact.messagePlaceholder.fr} data-ph-en={ui.contact.messagePlaceholder.en}></textarea>
          </label>
          <button type="submit" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"></path></svg>
            <T t={ui.contact.send} />
          </button>
        </form>
      </Reveal>

      {/* Direct links */}
      <Reveal delay={100}>
        <div class="direct">
          <p class="direct-label eyebrow"><T t={ui.contact.orReach} /></p>

          <button type="button" id="copyEmail" class="contact-card glass" data-email={email}>
            <span class="cc-icon"><Mail /></span>
            <span class="cc-body">
              <span class="cc-title">Email</span>
              <span class="cc-value mono">{email}</span>
            </span>
            <span class="cc-hint mono">
              <span class="copy-idle"><T t={ui.contact.copy} /></span>
              <span class="copy-done"><T t={ui.contact.copied} /></span>
            </span>
          </button>

          {
            phone && (
              <a href={`tel:${phone}`} class="contact-card glass">
                <span class="cc-icon"><Phone /></span>
                <span class="cc-body">
                  <span class="cc-title">Téléphone</span>
                  <span class="cc-value mono">{phone}</span>
                </span>
              </a>
            )
          }
          {
            linkedin && (
              <a href={linkedin} target="_blank" rel="noopener noreferrer" class="contact-card glass">
                <span class="cc-icon"><LinkedIn /></span>
                <span class="cc-body">
                  <span class="cc-title">LinkedIn</span>
                  <span class="cc-value mono">/in/hyacinthe-d-almeida</span>
                </span>
              </a>
            )
          }
          {
            github && (
              <a href={github} target="_blank" rel="noopener noreferrer" class="contact-card glass">
                <span class="cc-icon"><GitHub /></span>
                <span class="cc-body">
                  <span class="cc-title">GitHub</span>
                  <span class="cc-value mono">@devhyacinthe</span>
                </span>
              </a>
            )
          }
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .block {
    padding: 2.5rem 0;
  }
  .contact-grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.75rem;
    border-radius: 1rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field > span {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgb(var(--color-text-base));
  }
  input,
  textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border-radius: 0.6rem;
    font: inherit;
    font-size: 0.9rem;
    color: rgb(var(--color-text-base));
    background: rgba(var(--color-text-base), 0.04);
    border: 1px solid rgba(var(--color-text-base), 0.12);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    resize: vertical;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: rgb(var(--color));
    box-shadow: 0 0 0 3px rgba(var(--color), 0.15);
  }
  .form button {
    align-self: flex-start;
    margin-top: 0.25rem;
  }

  .direct {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .direct-label {
    margin-bottom: 0.25rem;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.1rem;
    border-radius: 0.8rem;
    width: 100%;
    text-align: left;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .contact-card:hover {
    transform: translateY(-2px);
  }
  .cc-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.6rem;
    flex-shrink: 0;
    color: rgb(var(--color));
    background: rgba(var(--color), 0.12);
  }
  .cc-icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .cc-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cc-title {
    font-size: 0.75rem;
    color: rgb(var(--color-text-muted));
  }
  .cc-value {
    font-size: 0.85rem;
    color: rgb(var(--color-text-base));
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cc-hint {
    margin-left: auto;
    font-size: 0.72rem;
    color: rgb(var(--color));
    flex-shrink: 0;
  }
  .copy-done {
    display: none;
    color: #22c55e;
  }
  .contact-card.copied .copy-idle {
    display: none;
  }
  .contact-card.copied .copy-done {
    display: inline;
  }
</style>

<script>
  function initContact() {
    // Localized placeholders (follow the current language).
    const root = document.documentElement;
    function applyPlaceholders() {
      const lang = root.getAttribute("data-lang") === "en" ? "en" : "fr";
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-ph-fr]").forEach((el) => {
        const val = el.getAttribute(`data-ph-${lang}`);
        if (val) el.placeholder = val;
      });
    }
    applyPlaceholders();
    document.getElementById("langToggle")?.addEventListener("click", () => setTimeout(applyPlaceholders, 0));

    // mailto submit
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const email = form.dataset.email ?? "";
      const data = new FormData(form);
      const name = String(data.get("name") ?? "");
      const subject = String(data.get("subject") ?? "");
      const message = String(data.get("message") ?? "");
      const body = `${message}\n\n— ${name}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });

    // copy email
    const copyBtn = document.getElementById("copyEmail");
    copyBtn?.addEventListener("click", async () => {
      const email = (copyBtn as HTMLElement).dataset.email ?? "";
      try {
        await navigator.clipboard.writeText(email);
        copyBtn.classList.add("copied");
        setTimeout(() => copyBtn.classList.remove("copied"), 2200);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }

  initContact();
  document.addEventListener("astro:page-load", initContact);
</script>
